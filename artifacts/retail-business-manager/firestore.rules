rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isActiveMember(spaceId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/spaces/$(spaceId)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/spaces/$(spaceId)/members/$(request.auth.uid)).data.status == 'active';
    }

    match /spaces/{spaceId} {
      allow read: if isActiveMember(spaceId);
      allow create, update, delete: if false;

      match /members/{uid} {
        allow read: if isActiveMember(spaceId) && uid == request.auth.uid;
        allow create, update, delete: if false;
      }
    }

    match /users/{uid} {
      allow read: if request.auth != null
        && request.auth.uid == uid;
      allow create, update, delete: if false;
    }

    match /users/{uid}/memberships/{spaceId} {
      allow read: if isActiveMember(spaceId)
        && request.auth.uid == uid;
      allow create, update, delete: if false;
    }

    match /spaces/{spaceId}/customers/{customerId} {
      allow read, delete: if isActiveMember(spaceId);
      allow create: if isActiveMember(spaceId)
        && isValidCustomerDocument(spaceId, customerId, request.resource.data)
        && (
          !request.resource.data.keys().hasAny(['createdByUserId'])
          || request.resource.data.createdByUserId == request.auth.uid
        );
      allow update: if isActiveMember(spaceId)
        && isValidCustomerDocument(spaceId, customerId, request.resource.data)
        && request.resource.data.id == resource.data.id
        && (
          !resource.data.keys().hasAny(['workspaceId'])
          || (
            request.resource.data.keys().hasAny(['workspaceId'])
            && request.resource.data.workspaceId == resource.data.workspaceId
          )
        )
        && (
          (
            !resource.data.keys().hasAny(['createdByUserId'])
            && !request.resource.data.keys().hasAny(['createdByUserId'])
          )
          || (
            resource.data.keys().hasAny(['createdByUserId'])
            && request.resource.data.keys().hasAny(['createdByUserId'])
            && request.resource.data.createdByUserId == resource.data.createdByUserId
          )
        );
    }

    match /spaces/{spaceId}/debts/{debtId} {
      allow read: if isActiveMember(spaceId);
      allow create: if isActiveMember(spaceId)
        && isValidDebtDocument(spaceId, debtId, request.resource.data)
        && hasActiveCustomer(spaceId, request.resource.data.customerId)
        && request.resource.data.createdByUserId == request.auth.uid;
      allow update: if isActiveMember(spaceId)
        && isValidDebtDocument(spaceId, debtId, request.resource.data)
        && hasActiveCustomer(spaceId, request.resource.data.customerId)
        && request.resource.data.id == resource.data.id
        && request.resource.data.storeId == resource.data.storeId
        && request.resource.data.workspaceId == resource.data.workspaceId
        && request.resource.data.createdByUserId == resource.data.createdByUserId
        && request.resource.data.customerId == resource.data.customerId
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isActiveMember(spaceId);
    }

    match /customers/{document=**} {
      allow read, write: if false;
    }

    match /transactions/{document=**} {
      allow read, write: if false;
    }

    match /debts/{document=**} {
      allow read, write: if false;
    }

    match /payments/{document=**} {
      allow read, write: if false;
    }

    match /ledgerEntries/{document=**} {
      allow read, write: if false;
    }

    match /settlements/{document=**} {
      allow read, write: if false;
    }

    match /dailyClosings/{document=**} {
      allow read, write: if false;
    }

    match /operationReceipts/{document=**} {
      allow read, write: if false;
    }

    match /auditEvents/{document=**} {
      allow read, write: if false;
    }

    match /stores/{spaceId} {
      allow read: if request.auth != null
        && resource.data.spaceId == spaceId
        && resource.data.ownerUserId == request.auth.uid;

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'spaceId',
          'ownerUserId',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.spaceId == spaceId
        && request.resource.data.ownerUserId == request.auth.uid
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is string;

      allow update: if request.auth != null
        && resource.data.spaceId == spaceId
        && resource.data.ownerUserId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'spaceId',
          'ownerUserId',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.spaceId == resource.data.spaceId
        && request.resource.data.ownerUserId == resource.data.ownerUserId
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is string;

      allow delete: if false;
    }

    function isValidCustomerDocument(spaceId, customerId, customer) {
      return customer.keys().hasOnly([
          'id',
          'storeId',
          'workspaceId',
          'createdByUserId',
          'name',
          'phone',
          'address',
          'notes',
          'isActive',
          'createdAt',
          'updatedAt'
        ])
        && customer.id == customerId
        && customer.storeId is string
        && customer.name is string
        && customer.isActive is bool
        && customer.createdAt is string
        && customer.updatedAt is string
        && (!customer.keys().hasAny(['workspaceId']) || customer.workspaceId == spaceId)
        && (!customer.keys().hasAny(['createdByUserId']) || customer.createdByUserId is string)
        && (!customer.keys().hasAny(['phone']) || customer.phone is string)
        && (!customer.keys().hasAny(['address']) || customer.address is string)
        && (!customer.keys().hasAny(['notes']) || customer.notes is string);
    }

    function hasActiveCustomer(spaceId, customerId) {
      return exists(/databases/$(database)/documents/spaces/$(spaceId)/customers/$(customerId))
        && get(/databases/$(database)/documents/spaces/$(spaceId)/customers/$(customerId)).data.id == customerId
        && get(/databases/$(database)/documents/spaces/$(spaceId)/customers/$(customerId)).data.isActive == true;
    }

    function isValidDebtDocument(spaceId, debtId, debt) {
      return debt.keys().hasOnly([
          'id',
          'storeId',
          'workspaceId',
          'createdByUserId',
          'customerId',
          'currency',
          'amount',
          'dueDate',
          'originalAmount',
          'settledAt',
          'createdAt',
          'updatedAt'
        ])
        && debt.keys().hasAll([
          'id',
          'storeId',
          'workspaceId',
          'createdByUserId',
          'customerId',
          'currency',
          'amount',
          'createdAt',
          'updatedAt'
        ])
        && debt.id == debtId
        && debt.storeId is string
        && debt.storeId.size() > 0
        && debt.workspaceId == spaceId
        && debt.createdByUserId is string
        && debt.createdByUserId.size() > 0
        && debt.customerId is string
        && debt.customerId.size() > 0
        && debt.currency in ['TRY', 'USD', 'EUR', 'GBP', 'SAR', 'AED', 'SYP']
        && debt.amount is number
        && debt.amount >= 0
        && (
          debt.amount > 0
          || (
            debt.keys().hasAll(['originalAmount', 'settledAt'])
            && debt.originalAmount is number
            && debt.originalAmount > 0
            && debt.settledAt is string
          )
        )
        && (
          !debt.keys().hasAny(['originalAmount'])
          || (
            debt.originalAmount is number
            && debt.originalAmount > 0
            && debt.originalAmount >= debt.amount
          )
        )
        && (!debt.keys().hasAny(['dueDate']) || (
          debt.dueDate is string
          && debt.dueDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        ))
        && (!debt.keys().hasAny(['settledAt']) || (
          debt.settledAt is string
          && debt.settledAt.size() > 0
        ))
        && debt.createdAt is string
        && debt.createdAt.size() > 0
        && debt.updatedAt is string
        && debt.updatedAt.size() > 0;
    }
  }
}