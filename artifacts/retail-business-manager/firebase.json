{
  "functions": {
    "source": "functions",
    "predeploy": [
      "pnpm --dir functions run build"
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "site": "retail-business-manager",
    "public": "dist",
    "ignore": ["firebase.json"],
    "rewrites": [{ "source": "**", "destination": "/index.html" }]
  },
  "emulators": {
    "firestore": {
      "port": 8080
    }
  }
}
