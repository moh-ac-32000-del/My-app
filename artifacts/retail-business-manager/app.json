{
  "expo": {
    "name": "Retail Business Manager",
    "slug": "retail-business-manager",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/store-accountant-icon.png",
    "scheme": "retail-business-manager",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/store-accountant-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#070A0E"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.retailbusinessmanager.app"
    },
    "android": {
      "package": "com.retailbusinessmanager.app",
      "googleServicesFile": "./google-services.json",
      "versionCode": 2
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/store-accountant-icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "7cc829f1-b0ee-4dfc-a340-88d1de0b83bc"
      }
    },
    "owner": "majams-team"
  }
}
