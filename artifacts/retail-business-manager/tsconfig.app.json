{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "baseUrl": ".",
    "strict": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "app/**/*",
    "components/**/*",
    "constants/**/*",
    "context/**/*",
    "data/**/*",
    "hooks/**/*",
    "services/**/*",
    "types/**/*",
    "tests/**/*",
    "*.ts",
    "*.tsx",
    "expo-env.d.ts"
  ],
  "exclude": [
    "functions/**/*",
    "tests/bootstrap-primary-space-function.test.ts",
    "node_modules",
    ".expo"
  ]
}
